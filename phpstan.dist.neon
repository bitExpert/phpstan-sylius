parameters:
    level: max
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - tests
    excludePaths:
        # Grid test fixtures - reference non-existent classes or grid-bundle 1.16+ only
        - tests/bitExpert/PHPStan/Sylius/Rule/Grid/data/*
        # Resource test fixtures - reference non-existent classes (FactoryClassNotExists, etc.)
        - tests/bitExpert/PHPStan/Sylius/Rule/Resource/data/*
    fileExtensions:
        - php
